# GPU pipeline image for rented GPU hosts (Vast.ai etc.).
# Base: Vast's own PyTorch image — pre-cached on many Vast hosts, so a
# cache-hit host only pulls our dep/model/code layers.
# torch 2.11 to match the newest existing torchaudio (torchaudio is frozen
# upstream and lags torch; the -auto tags run torch 2.14 which no torchaudio fits)
FROM docker.io/vastai/pytorch:2.11.0-cu128-cuda-12.9-mini-py311-2026-09-08
WORKDIR /app
COPY pyproject.toml ./
# adtof-pytorch is uv-git-sourced in pyproject ([tool.uv.sources]), which plain
# resolvers ignore and PyPI doesn't have; rewrite to a PEP 508 direct reference.
# Guard against the base image's torch being too old or getting shadowed.
# Deps install from pyproject alone (-r reads [project.dependencies]) so this
# multi-GB layer survives code changes; src arrives later and installs in
# seconds with --no-deps.
RUN sed -i 's|"adtof-pytorch"|"adtof-pytorch @ git+https://github.com/xavriley/ADTOF-pytorch"|' pyproject.toml \
    # drop laptop-specific uv config (CPU-only torch index) so torchaudio
    # resolves to the CUDA build matching the base image's torch
    && sed -i '/^\[tool\.uv\]/,$d' pyproject.toml \
    && printf '\n[tool.hatch.metadata]\nallow-direct-references = true\n' >> pyproject.toml \
    && uv pip install --python /venv/main/bin/python --no-cache -r pyproject.toml onnxruntime-gpu \
    && /venv/main/bin/python -c "import torch; v=tuple(map(int, torch.__version__.split('+')[0].split('.')[:2])); assert v >= (2, 6), torch.__version__; assert torch.version.cuda"
# model checkpoints baked in; pipeline resolves .cache/ and .models/ relative to CWD
COPY .cache ./.cache
COPY .models ./.models
# MuseScore for the .mscz export: the official AppImage, unpacked (no FUSE
# in containers); its fallback libs cover what the base image lacks.
# Same version as atom's nixpkgs musescore.
RUN curl -fsSL -o /tmp/ms.AppImage https://github.com/musescore/MuseScore/releases/download/v4.7.4/MuseScore-Studio-4.7.4.260706075-x86_64.AppImage \
    && echo "9233ed1b87d3e6b45722278f3c286dcd41e83da778bd0f80a1dd04949696ad93  /tmp/ms.AppImage" | sha256sum -c \
    && chmod +x /tmp/ms.AppImage && cd /opt && /tmp/ms.AppImage --appimage-extract >/dev/null \
    && mv squashfs-root musescore && rm /tmp/ms.AppImage \
    && ln -s /opt/musescore/AppRun /usr/local/bin/musescore
COPY src ./src
RUN uv pip install --python /venv/main/bin/python --no-cache --no-deps .
COPY deploy ./deploy
ENV TORCH_HOME=/app/.cache/torch HF_HOME=/app/.cache/hf XDG_CACHE_HOME=/app/.cache
ENTRYPOINT ["/venv/main/bin/drum-transcribe"]
